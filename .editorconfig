# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf
max_line_length = 80

[*.{md,yml}]
max_line_length = off
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

[*.txt]
insert_final_newline = false

# shfmt reads these, also for scripts with a shebang and no extension
[[shell]]
indent_style = tab
switch_case_indent = true

# shfmt 3.14 changes the meaning of some zsh expansions, such as $((...))
# inside ${${(M)...}}. This section keeps the zsh scripts out of a shfmt walk of
# the tree. The make targets list no zsh script.
[*.zsh]
ignore = true
